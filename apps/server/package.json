{
  "name": "@untangle/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "tsx src/main.ts",
    "supervise": "tsx --env-file=../../.env scripts/supervise.ts",
    "dev:sim": "tsx watch --env-file-if-exists=../../.env src/sim/dev-sim.ts",
    "seed": "tsx --env-file=../../.env scripts/seed.ts",
    "webhooks": "tsx --env-file=../../.env scripts/webhooks.ts",
    "check": "tsx --env-file=../../.env scripts/check-setup.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/google": "^1.2.22",
    "@fastify/rate-limit": "^10",
    "@fastify/static": "^10.1.8",
    "@paypal/agent-toolkit": "1.11.0",
    "@untangle/db": "workspace:*",
    "@untangle/engine": "workspace:*",
    "@untangle/executor": "workspace:*",
    "@untangle/paypal": "workspace:*",
    "ai": "^4.3.19",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.0.0",
    "tsx": "^4.19.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/node": "^22",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  }
}
