# Copy to .env and fill in. Never commit .env.
# Everything here is SANDBOX / free tier. The server refuses live PayPal.

# Neon Postgres (free tier). Create a project in AWS us-east-2 (Ohio) to sit next to Render Ohio.
DATABASE_URL=postgres://USER:PASSWORD@HOST/neondb?sslmode=require

# 32 random bytes as hex. It encrypts the PayPal credentials stored in the database.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=

# Optional. HMAC key for the two-sided confirmation links. Falls back to MASTER_KEY when unset.
# Generate like MASTER_KEY. Add it here to rotate confirmation links independently.
CONFIRM_SECRET=

# Gemini API key from Google AI Studio (free tier).
GEMINI_API_KEY=

# AG Grid Enterprise trial key. Request it around Nov 10-12; it may stay empty until then (5-second watermark).
AG_GRID_LICENSE_KEY=

# The app's own PayPal sandbox REST app, with "Log in with PayPal" enabled.
# Return URL in the dashboard: http://localhost:5173/auth/paypal/callback (plus the Render URL later).
PAYPAL_PLATFORM_CLIENT_ID=
PAYPAL_PLATFORM_CLIENT_SECRET=

# The nine demo businesses. Each is a sandbox BUSINESS account with its own REST app.
# In each app's settings, turn on "Transaction search".
# Copy the sandbox account email, the app's client id and the app's secret.
PAYPAL_BIZ_1_NAME=Rosa's Bakery
PAYPAL_BIZ_1_EMAIL=
PAYPAL_BIZ_1_CLIENT_ID=
PAYPAL_BIZ_1_CLIENT_SECRET=

PAYPAL_BIZ_2_NAME=Rossi Mill
PAYPAL_BIZ_2_EMAIL=
PAYPAL_BIZ_2_CLIENT_ID=
PAYPAL_BIZ_2_CLIENT_SECRET=

